{
  "expo": {
    "name": "LINK CI",
    "slug": "link-ci",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FF6B35"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.linkci.app"
    },
    "android": {
      "package": "com.linkci.app",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF6B35",
        "backgroundImage": "./assets/adaptive-background.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "LinkCI a besoin de tes photos pour que tu puisses les partager dans le fil.",
          "cameraPermission": "LinkCI a besoin de l'appareil photo pour prendre une photo a publier."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#FF6B35"
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "LinkCI utilise le micro pour enregistrer tes notes vocales."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "LinkCI utilise l'appareil photo pour scanner le QR code d'un camarade.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "LinkCI utilise Face ID pour proteger l'ouverture de l'app."
        }
      ]
    ],
    "description": "Le reseau social des etudiants de Cote d'Ivoire.",
    "extra": {
      "eas": {
        "projectId": "79b542e5-bbfd-4213-ba5d-a428bd7f98df"
      }
    },
    "owner": "adehoda",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/79b542e5-bbfd-4213-ba5d-a428bd7f98df",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
